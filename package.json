{
  "name": "competitorx",
  "version": "1.0.0",
  "description": "CompetitorX — AI-Powered Website Comparison Agent",
  "private": true,
  "scripts": {
    "install:all": "npm --prefix backend install && npm --prefix frontend install",
    "build": "npm --prefix frontend install && npm --prefix frontend run build && npm --prefix backend install",
    "start": "node backend/src/server.js",
    "dev:backend": "npm --prefix backend run dev",
    "dev:frontend": "npm --prefix frontend run dev",
    "dev": "npm run start"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": [
    "competitorx",
    "ai-agent",
    "tinyfish",
    "competitive-intelligence",
    "web-research"
  ],
  "author": "Ankit Yadav",
  "license": "MIT"
}
